// silicyOS Minimalist Apple Silicon Boot Splash Script (Dark #0c0c12 Canvas)
Window.SetBackgroundTopColor(0.047, 0.047, 0.071);
Window.SetBackgroundBottomColor(0.047, 0.047, 0.071);

logo.image = Image("silicyos-boot.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(1.0);
logo.sprite.SetZ(10);
