// =============================================================================
// silicyOS Default Compositor — Niri (Scrollable Tiling Wayland Compositor)
// Theme: Apple Industrial Titanium (#0B0B0E, #141418, #26262E, #F2F2F7, #8E8E93, #0A84FF)
// Target: Apple Silicon M1/M2/M3 (Asahi 16K Page Size + CachyOS BORE)
// =============================================================================

environment {
    GSK_RENDERER "ngl"
    WLR_RENDERER "gles2"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    SDL_VIDEODRIVER "wayland"
    _JAVA_AWT_WM_NONREPARENTING "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
}

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 220
        repeat-rate 38
    }

    touchpad {
        tap
        natural-scroll
        dwt
        dwtp
        accel-speed 0.18
        accel-profile "adaptive"
        scroll-method "two-finger"
        scroll-factor 0.85
        click-method "clickfinger"
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="10%"
}

// Apple Retina / Liquid Retina ProMotion Auto-Scale & VRR
output "eDP-1" {
    scale 2.0
    variable-refresh-rate on-demand=true
    position x=0 y=0
}

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.381966
        proportion 0.5
        proportion 0.618034
        proportion 0.85
    }

    default-column-width { proportion 0.5; }

    // Disable focus-ring to use crisp 1.5px Apple Industrial Titanium border
    focus-ring {
        off
    }

    border {
        on
        width 1.5
        active-gradient from="#0A84FF" to="#26262E" angle=135
        inactive-color "#26262E"
    }

    // Disable heavy compositor shadows to save Apple AGX GPU & battery
    shadow {
        off
    }

    struts {
        left 4
        right 4
        top 2
        bottom 4
    }
}

prefer-no-csd

spawn-at-startup "waybar"
spawn-at-startup "swayosd-server"
spawn-at-startup "sh" "-c" "grep -qi '^PC' /etc/silicy-kb-mode 2>/dev/null || exec keyd-application-mapper -d"

screenshot-path "~/Pictures/Screenshots/silicyOS-%Y-%m-%d_%H-%M-%S.png"

animations {
    slowdown 0.88

    workspace-switch {
        spring damping-ratio=0.92 stiffness=850 epsilon=0.0001
    }

    window-open {
        duration-ms 170
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=0.90 stiffness=820 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.90 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.92 stiffness=850 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.82 stiffness=900 epsilon=0.001
    }
}

// Global 14px Concentric Rounded Corners (Apple HIG)
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id=r#"^kitty$"#
    opacity 0.96
}

window-rule {
    match is-active=false
    opacity 0.92
}

binds {
    // --- Core macOS-Style Command (Mod / Super) Binds ---
    Mod+Return     { spawn "kitty"; }
    Mod+Space      { spawn "fuzzel"; }
    Mod+Ctrl+Space { spawn "silicy-center"; }
    Mod+Slash      { spawn "silicy-center" "--shortcuts"; }
    Mod+Q          { close-window; }
    Alt+F4         { close-window; }

    // --- Screenshots (macOS Shift+Cmd+3 / Shift+Cmd+4 Parity + Print) ---
    Print       { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }
    Mod+Shift+3 { spawn "sh" "-c" "grim - | wl-copy"; }
    Mod+Shift+4 { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }
    Mod+Shift+5 { screenshot; }

    // --- Apple Silicon Hardware Function Keys (SwayOSD Frosted HUD + speakersafetyd) ---
    XF86MonBrightnessUp   allow-when-locked=true { spawn "sh" "-c" "swayosd-client --brightness +5 || brightnessctl -q set +5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "swayosd-client --brightness -5 || brightnessctl -q set 5%-"; }
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "sh" "-c" "brightnessctl -d '*kbd_backlight*' -q set +10% && swayosd-client --custom-icon keyboard-brightness-symbolic --custom-message 'Keyboard Backlight +10%'"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "sh" "-c" "brightnessctl -d '*kbd_backlight*' -q set 10%- && swayosd-client --custom-icon keyboard-brightness-symbolic --custom-message 'Keyboard Backlight -10%'"; }

    XF86AudioRaiseVolume  allow-when-locked=true { spawn "sh" "-c" "swayosd-client --output-volume +5 --max-volume 100 || wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "sh" "-c" "swayosd-client --output-volume -5 --max-volume 100 || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "sh" "-c" "swayosd-client --output-volume mute-toggle || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "sh" "-c" "swayosd-client --input-volume mute-toggle || wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // --- Scrollable Strip Navigation (H/J/K/L & Arrow Keys) ---
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // --- Workspace Navigation ---
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }

    // --- Column & Window Sizing (Avoid hijacking Mod+C/V/T/W/A/X/Z) ---
    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+C { center-column; }
    Mod+Minus   { set-column-width "-10%"; }
    Mod+Equal   { set-column-width "+10%"; }
    Mod+Shift+V { toggle-window-floating; }

    // --- Session Controls ---
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
