{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/silicy-logo",
    "niri/workspaces",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "custom/soc-temp",
    "custom/ram-zram",
    "custom/macsmc-power",
    "wireplumber",
    "network",
    "battery"
  ],

  "custom/silicy-logo": {
    "format": " 󰀵 silicyOS",
    "tooltip-format": "silicyOS Control Center (Super + Ctrl + Space)",
    "on-click": "silicy-center",
    "on-click-right": "fuzzel"
  },

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○"
    }
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "active": "●",
      "default": "○"
    },
    "sort-by-number": true
  },

  "custom/soc-temp": {
    "interval": 5,
    "exec": "silicy-ctl telemetry --temp",
    "format": "󰔏 {}",
    "on-click": "silicy-center --power",
    "tooltip-format": "Apple Silicon M-Series SoC Die Thermal Sensor (/sys/class/hwmon/hwmon*/temp1_input)"
  },

  "custom/ram-zram": {
    "interval": 5,
    "exec": "silicy-ctl telemetry --memory",
    "format": "󰍛 {}",
    "tooltip-format": "Active RAM (16K Pages) + Compressed ZRAM Usage (/proc/meminfo)"
  },

  "custom/macsmc-power": {
    "interval": 3,
    "exec": "silicy-ctl telemetry",
    "return-type": "json",
    "format": "󱐋 {text}",
    "on-click": "silicy-center --power",
    "tooltip-format": "Apple SMC Real-time Package & Battery Power Draw (/sys/class/power_supply/macsmc-battery/power_now)"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "swayosd-client --output-volume mute-toggle || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5.0,
    "max-volume": 100
  },

  "network": {
    "interface": "wlan*",
    "interval": 5,
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Ethernet",
    "format-disconnected": "󰤭 Offline",
    "tooltip-format-wifi": "iwd • {essid} ({signalStrength}%) • {ipaddr}",
    "on-click": "kitty -e iwctl"
  },

  "battery": {
    "bat": "macsmc-battery",
    "interval": 15,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󱘖 {capacity}%",
    "on-click": "silicy-center --battery",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },

  "clock": {
    "interval": 30,
    "format": "{:%a %b %d  %H:%M}",
    "on-click": "silicy-center --display",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  }
}
